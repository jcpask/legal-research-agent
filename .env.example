# Optional but recommended for a whole class: raises CourtListener's rate
# limit and unlocks full opinion text via get_opinion_text.
# Sign up free at https://www.courtlistener.com, then find your token
# under your profile's "API" / "Your API Token" page.
COURTLISTENER_API_TOKEN=

# Set automatically by most hosts (e.g. Render); only needed for local runs.
PORT=8000
